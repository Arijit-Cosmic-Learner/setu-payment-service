# -----------------------------------------------
# LOCAL DEVELOPMENT (SQLite - no setup needed)
# -----------------------------------------------
DATABASE_URL=sqlite:///./setu_payments.db
DEBUG=true
APP_NAME=Setu Payment Service
APP_VERSION=1.0.0

# -----------------------------------------------
# PRODUCTION (PostgreSQL on Supabase & Vercel)
# Add this in Vercel Environment Variables from the database service.
# Format: postgresql://user:password@host:port/dbname
# -----------------------------------------------
# DATABASE_URL=postgresql://setu_user:password@host/setu_payments
# DEBUG=false

