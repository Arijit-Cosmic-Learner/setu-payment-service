# ============================================================
# Setu Payment Service - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file to Git

# Database URL
# Local SQLite (development) - no setup required
DATABASE_URL=sqlite:///./setu_payments.db

# PostgreSQL (production on Render) - uncomment when deploying
# DATABASE_URL=postgresql://user:password@host:5432/setu_payments

# App Settings
APP_NAME=Setu Payment Service
APP_VERSION=1.0.0
DEBUG=true

# Pagination defaults
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
